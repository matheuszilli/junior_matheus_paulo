<mxfile host="app.diagrams.net" modified="2026-08-29T00:00:00.000Z" agent="draw.io" version="24.7.5">
  <diagram name="DFD API TP1" id="dfd-tp1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="DFD — API do Sistema de Atendimento ao Cliente (PB TP1)&#10;Grupo: Junior, Matheus e Paulo — FastAPI + JWT, sem banco de dados (TP1)" style="text;html=1;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cliente" value="ENTIDADE EXTERNA&#10;&#10;Cliente (usuário admin)&#10;&#10;Envia credenciais e textos;&#10;recebe token e intenções" style="rounded=0;whiteSpace=wrap;html=1;double=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="230" height="280" as="geometry" />
        </mxCell>
        <mxCell id="boundary" style="endArrow=none;dashed=1;dashPattern=8 6;strokeColor=#B23A3A;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="130" as="sourcePoint" />
            <mxPoint x="400" y="960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="boundary_lbl" value="TRUST BOUNDARY — fronteira Internet / API (dados em trânsito).&#10;Toda travessia: autenticar e validar a entrada." style="text;html=1;align=center;fontColor=#B23A3A;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="api" value="API FastAPI — executada com uvicorn main:app --reload (127.0.0.1:8000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#2C5F8A;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#2C5F8A" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="880" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="P1 — POST /auth/token&#10;Autenticação&#10;(OAuth2PasswordRequestForm → JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#2C5F8A;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="530" y="220" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="P2 — POST /predict&#10;Predição de intenção&#10;(simulada — protegida por JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#2C5F8A;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="530" y="480" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="P3 — GET /health&#10;Monitoramento da API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#2C5F8A;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="530" y="740" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="D1 — Credenciais admin + SECRET_KEY (in-code)&#10;security/autenticacao.py" style="shape=partialRectangle;right=0;whiteSpace=wrap;html=1;fillColor=#FDF6E3;strokeColor=#2C5F8A;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1030" y="330" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="Sem banco de dados no TP1.&#10;Persistência (SQLite/SQLModel) prevista para as próximas etapas." style="text;html=1;align=center;fontStyle=2;fontColor=#555555;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1000" y="740" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="E1: username + password (formulário)" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11" edge="1" parent="1" source="cliente" target="p1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="270" y="400" as="sourcePoint" /><mxPoint x="530" y="260" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s1" value="S1: access_token (JWT) | erro 401 (WWW-Authenticate)" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.35" edge="1" parent="1" source="p1" target="cliente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="E2: JWT (Bearer) + texto (JSON)" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11" edge="1" parent="1" source="cliente" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="S2: intencao | 401 token inválido | 422 entrada inválida" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.65" edge="1" parent="1" source="p2" target="cliente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="E3: requisição GET" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11" edge="1" parent="1" source="cliente" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3: {status: ok}" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.9" edge="1" parent="1" source="p3" target="cliente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="lê credenciais e chave (compare_digest; assina HS256)" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11" edge="1" parent="1" source="p1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="lê chave (valida assinatura e exp)" style="endArrow=block;html=1;strokeColor=#2C5F8A;fontSize=11" edge="1" parent="1" source="p2" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cia" value="TRÍADE CIA POR COMPONENTE&#10;&#10;Cliente (entidade externa) — C: guarda senha e token; token vazado dá acesso até expirar (30 min). I: envia dados que a API valida (Pydantic, extra=&quot;forbid&quot; no /predict). A: depende da API para autenticar e classificar mensagens.&#10;&#10;P1 /auth/token — C: recebe a senha em claro no corpo; não registrar em log; TLS em produção. I: só ele emite JWT, assinado (HS256); comparação em tempo constante. A: se cair, ninguém obtém token — bloqueia todas as rotas protegidas.&#10;&#10;P2 /predict — C: texto do cliente pode conter dado pessoal; acesso só com JWT válido. I: valida assinatura e expiração antes de responder; resposta via response_model. A: função principal do sistema; depende de P1 e D1.&#10;&#10;P3 /health — C: baixa, expõe apenas status. I: resposta fixa; adulteração enganaria o monitoramento. A: alta — é o verificador de disponibilidade da API.&#10;&#10;D1 Credenciais + SECRET_KEY (in-code) — C: CRÍTICA, chave vazada permite forjar tokens; senha vazada, logar como admin. I: CRÍTICA, alteração quebra autenticação e validação. A: lida em todo login e em toda validação de token.&#10;&#10;Entradas: E1 username+password, E2 JWT+texto, E3 GET. Saídas: S1 access_token/401, S2 intencao/401/422, S3 status." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;fillColor=#FFFFFF;strokeColor=#C9D6E2" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1320" height="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
